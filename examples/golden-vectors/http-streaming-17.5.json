        {"label": "response data lifecycle", "actual_path": ["results", 0, "events_fired"], "reference_path": ["results", 0, "events_fired"]},
        {"label": "first response segment", "actual_path": ["trace", 1, "staged_response_body_received"], "reference_path": ["trace", 1, "staged_response_body_received"]},
        {"label": "completed response body", "actual_path": ["trace", 2, "staged_response_body_received"], "reference_path": ["trace", 2, "staged_response_body_received"]}
      ]
    },
    {
