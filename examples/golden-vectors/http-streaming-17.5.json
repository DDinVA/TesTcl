        "packets": [
          {
            "protocol": "tcp",
            "direction": "client_to_server",
            "source": {"address": "10.0.0.1", "port": 51006},
            "destination": {"address": "192.0.2.10", "port": 80},
            "payload": "POST /first HTTP/1.1\r\nHost: app.example\r\nContent-Length: 3\r\n\r\nabcGET /second HTTP/1.1\r\nHost: app.example\r\n\r\n"
          },
          {
            "protocol": "tcp",
            "direction": "server_to_client",
            "source": {"address": "192.0.2.10", "port": 80},
