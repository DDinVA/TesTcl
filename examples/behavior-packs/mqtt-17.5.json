{
  "schema_version": 1,
  "profile": "tmos-17.5",
  "name": "mqtt-17.5",
  "cases": [
    {"id": "clean-session", "probe": {"command": "MQTT::clean_session", "args": ["0"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "client-id", "probe": {"command": "MQTT::client_id", "args": ["testcl"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "testcl", "event_fired": true}},
    {"id": "collect", "probe": {"command": "MQTT::collect", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "disable", "probe": {"command": "MQTT::disable", "event": "CLIENT_ACCEPTED", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "disconnect", "probe": {"command": "MQTT::disconnect", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "drop", "probe": {"command": "MQTT::drop", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "dup", "probe": {"command": "MQTT::dup", "args": ["0"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "enable", "probe": {"command": "MQTT::enable", "event": "CLIENT_ACCEPTED", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "insert", "probe": {"command": "MQTT::insert", "args": ["before", "type", "PUBLISH", "topic", "testcl/command", "payload", "testcl"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "keep-alive", "probe": {"command": "MQTT::keep_alive", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"], "state": {"mqtt": {"type": "PUBLISH", "keep_alive": 30, "topic": "testcl/command", "payload": "testcl", "message_length": 24}}}, "expect": {"status": "ok", "value": "30", "event_fired": true}},
    {"id": "length", "probe": {"command": "MQTT::length", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"], "state": {"mqtt": {"type": "PUBLISH", "keep_alive": 30, "topic": "testcl/command", "payload": "testcl", "message_length": 24}}}, "expect": {"status": "ok", "value": "24", "event_fired": true}},
    {"id": "message", "probe": {"command": "MQTT::message", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT", "MR"], "state": {"mqtt": {"type": "PUBLISH", "keep_alive": 30, "topic": "testcl/command", "payload": "testcl", "message_length": 24}}}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "packet-id", "probe": {"command": "MQTT::packet_id", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "password", "probe": {"command": "MQTT::password", "args": ["testcl-secret"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "testcl-secret", "event_fired": true}},
    {"id": "payload", "probe": {"command": "MQTT::payload", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"], "state": {"mqtt": {"type": "PUBLISH", "keep_alive": 30, "topic": "testcl/command", "payload": "testcl", "message_length": 24}}}, "expect": {"status": "ok", "value": "testcl", "event_fired": true}},
    {"id": "protocol-name", "probe": {"command": "MQTT::protocol_name", "args": ["testcl"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "testcl", "event_fired": true}},
    {"id": "protocol-version", "probe": {"command": "MQTT::protocol_version", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "4", "event_fired": true}},
    {"id": "qos", "probe": {"command": "MQTT::qos", "args": ["0"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "release", "probe": {"command": "MQTT::release", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "replace", "probe": {"command": "MQTT::replace", "args": ["type", "PUBLISH", "topic", "testcl/command", "payload", "testcl"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "respond", "probe": {"command": "MQTT::respond", "args": ["type", "CONNACK", "return_code", "0"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "retain", "probe": {"command": "MQTT::retain", "args": ["0"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "return-code", "probe": {"command": "MQTT::return_code", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "return-code-list", "probe": {"command": "MQTT::return_code_list", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "event_fired": true}},
    {"id": "session-present", "probe": {"command": "MQTT::session_present", "args": ["0"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "0", "event_fired": true}},
    {"id": "topic", "probe": {"command": "MQTT::topic", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"], "state": {"mqtt": {"type": "PUBLISH", "keep_alive": 30, "topic": "testcl/command", "payload": "testcl", "message_length": 24}}}, "expect": {"status": "ok", "value": "testcl/command", "event_fired": true}},
    {"id": "type", "probe": {"command": "MQTT::type", "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"], "state": {"mqtt": {"type": "PUBLISH", "keep_alive": 30, "topic": "testcl/command", "payload": "testcl", "message_length": 24}}}, "expect": {"status": "ok", "value": "PUBLISH", "event_fired": true}},
    {"id": "username", "probe": {"command": "MQTT::username", "args": ["NAME"], "event": "MQTT_CLIENT_DATA", "profiles": ["TCP", "MQTT"]}, "expect": {"status": "ok", "value": "NAME", "event_fired": true}},
    {"id": "will-topic", "probe": {"command": "MQTT::will", "args": ["topic", "testcl"], "event": "MQTT_CLIENT_INGRESS", "profiles": ["TCP", "MQTT"], "state": {"mqtt": {"type": "CONNECT", "client_id": "testcl-1705", "keep_alive": 60, "will_topic": "", "will_message": "", "will_qos": 0, "will_retain": 0, "will_flag": 0}}}, "expect": {"status": "ok", "value": "testcl", "event_fired": true}}
  ]
