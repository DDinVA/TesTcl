{
  "schema_version": 1,
  "profile": "tmos-17.5",
  "name": "dosl7-controls-17.5",
  "cases": [
    {
      "id": "dosl7-policy-inspection-and-request-overrides",
      "scenario": {
        "profiles": ["TCP", "HTTP", "FASTHTTP"],
        "dosl7": {
          "enabled": true,
          "health": 7,
          "profile": "/Common/dos-profile",
          "mitigated": true,
          "greylist": {
            "10.0.0.1": {"rate": 10, "timeout": 60}
          }
        },
        "irule": "when HTTP_REQUEST { if {[HTTP::uri] eq \"/disable\"} { DOSL7::disable } elseif {[HTTP::uri] eq \"/enable\"} { DOSL7::enable /Common/override } elseif {[HTTP::uri] eq \"/slow\"} { DOSL7::slowdown 30 120 }; log local0. \"profile=[DOSL7::profile] health=[DOSL7::health] slowed=[DOSL7::is_ip_slowdown] mitigated=[DOSL7::is_mitigated]\" }",
        "requests": [
          {"uri": "/inspect"},
          {"uri": "/disable"},
          {"uri": "/enable"},
          {"uri": "/slow"},
          {"uri": "/inspect", "new_connection": true}
        ]
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {"path": ["results", 0, "semantic", "dosl7", "profile"], "equals": "/Common/dos-profile"},
          {"path": ["results", 0, "semantic", "dosl7", "health"], "equals": 7},
          {"path": ["results", 0, "semantic", "dosl7", "mitigated"], "equals": true},
          {"path": ["results", 1, "semantic", "dosl7", "enabled"], "equals": false},
          {"path": ["results", 1, "semantic", "dosl7", "profile"], "equals": "/Common/dos-profile"},
          {"path": ["results", 2, "semantic", "dosl7", "enabled"], "equals": true},
          {"path": ["results", 2, "semantic", "dosl7", "profile_object"], "equals": "/Common/override"},
          {"path": ["results", 3, "semantic", "dosl7", "greylist", "10.0.0.1", "rate"], "equals": 30},
          {"path": ["results", 3, "semantic", "dosl7", "greylist", "10.0.0.1", "timeout"], "equals": 120},
          {"path": ["results", 4, "semantic", "dosl7", "profile_object"], "equals": ""}
        ]
      }
    }
  ]
}
