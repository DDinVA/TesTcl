      "expect": {"status": "ok", "value": "400"}
    },
    {
      "id": "clear-removes-entry-for-later-request",
      "scenario": {
        "profiles": ["TCP", "HTTP"],
        "route": {"domain": "7", "metrics": [{"destination": "192.0.2.10", "gateway": "192.0.2.1", "age": 12, "expiration": 300, "mtu": 1500, "rtt": 3200, "rttvar": 400, "cwnd": 14600, "bandwidth": 3650}]},
        "irule": "when HTTP_REQUEST { set before [ROUTE::age 192.0.2.10 192.0.2.1]; ROUTE::clear 192.0.2.10 192.0.2.1; HTTP::respond 200 content \"before=$before after=[ROUTE::age 192.0.2.10 192.0.2.1] domain=[ROUTE::domain]\" }",
        "requests": [
          {"method": "GET", "uri": "/one", "headers": {"Host": "example.test"}},
          {"method": "GET", "uri": "/two", "headers": {"Host": "example.test"}}
        ]
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {"path": ["results", 0, "response", "body"], "equals": "before=12 after=0 domain=7"},
          {"path": ["results", 1, "response", "body"], "equals": "before=0 after=0 domain=7"},
          {"path": ["results", 0, "decisions", 0], "equals": "route clear {{destination 192.0.2.10 gateway 192.0.2.1}}"}
        ]
      }
    }
  ]
}
