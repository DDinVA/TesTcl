{
  "schema_version": 1,
  "profile": "tmos-17.5",
  "name": "tcp-17.5",
  "cases": [
    {
      "id": "client-port",
      "probe": {
        "command": "TCP::client_port",
        "event": "CLIENT_ACCEPTED",
        "profiles": ["TCP"],
        "state": {"connection": {"client_addr": "192.0.2.1", "client_port": 54321}}
      },
      "expect": {"status": "ok", "value": "54321", "tcl_return_code": 0}
    },
    {
      "id": "mss",
      "probe": {
        "command": "TCP::mss",
        "event": "CLIENT_ACCEPTED",
        "profiles": ["TCP"],
        "state": {"connection": {"mss": 1460}}
      },
      "expect": {"status": "ok", "value": "1460"}
    },
    {
      "id": "rtt",
      "probe": {
        "command": "TCP::rtt",
        "event": "CLIENT_ACCEPTED",
        "profiles": ["TCP"],
        "state": {"connection": {"rtt": 25}}
      },
      "expect": {"status": "ok", "value": "25"}
    },
    {
      "id": "client-payload",
      "probe": {
        "command": "TCP::payload",
        "event": "CLIENT_DATA",
        "profiles": ["TCP"],
        "state": {"connection": {"client_payload": "hello"}}
      },
      "expect": {"status": "ok", "value": "hello", "value_bytes": 5}
    },
    {
      "id": "payload-length",
      "probe": {
        "command": "TCP::payload",
        "args": ["length"],
        "event": "CLIENT_DATA",
        "profiles": ["TCP"],
        "state": {"connection": {"client_payload": "hello"}}
      },
      "expect": {"status": "ok", "value": "5"}
    },
    {
      "id": "payload-argument-error",
      "probe": {
        "command": "TCP::payload",
        "args": ["not-a-length"],
        "event": "CLIENT_DATA",
        "profiles": ["TCP"],
        "state": {"connection": {"client_payload": "hello"}}
      },
      "expect": {"status": "error", "tcl_return_code": 1, "error_contains": "optional non-negative size"}
    }
  ]
}
