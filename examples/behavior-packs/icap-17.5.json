{
  "schema_version": 1,
  "profile": "tmos-17.5",
  "name": "icap-17.5",
  "cases": [
    {
      "id": "raw-reqmod-encapsulated-body",
      "scenario": {
        "profiles": ["TCP", "ICAP"],
        "irule": "when ICAP_REQUEST { log local0. \"method=[ICAP::method] uri=[ICAP::uri] host=[ICAP::header value Host]\" ICAP::header add X-Raw yes }",
        "packets": [
          {
            "protocol": "tcp",
            "direction": "client_to_server",
            "source": {"address": "192.0.2.10", "port": 51000},
            "destination": {"address": "198.51.100.20", "port": 1344},
            "payload_hex": ""
          }
        ]
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {"path": ["trace", 0, "events", 2, "event"], "equals": "ICAP_REQUEST"},
          {"path": ["trace", 0, "events", 2, "state", "icap", "method"], "equals": "REQMOD"},
          {"path": ["trace", 0, "events", 2, "state", "icap", "uri"], "equals": "icap://icap.example.net/reqmod"}
        ]
      }
    }
  ]
}
